    "screen": 40,
    "sheet": 28,
    "card": 24,
    "bubble": 20,
    "bubbleTail": 6,
    "tile": 16,
    "field": 16,
    "chip": 18,
    "iconTile": 12,
    "button": 24,
    "pill": 9999,
    "checkbox": 6,
    "badge": 10,
    "tileSm": 14,
    "bubbleAi": 22,
    "panel": 26,
    "nav": 30
