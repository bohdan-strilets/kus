  "gradient": {
    "appBackground": "linear-gradient(165deg, #FCEBD8 0%, #FBF6EE 50%, #EEF4E8 100%)",
    "logo": "linear-gradient(150deg, #FFB877 0%, #D45F22 100%)",
    "softCard": "linear-gradient(120deg, #FDEBDB, #FBF3E6)",
    "darkCard": "linear-gradient(120deg, #2A2118, #3D2D20)",
    "appIconBackground": "linear-gradient(160deg, #FFF3E6 0%, #FBF5EC 55%, #F1F2E6 100%)",
    "avatar": "linear-gradient(140deg, #FFE1C4, #F6C79B)",
    "planCard": "linear-gradient(140deg, #FCE6D2, #FCEBDD)",
    "achievementCard": "linear-gradient(140deg, #FCE6D2, #FDF3E7)"
  },
  "font": {
    "family": "'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "weights": [
      400,
      500,
      600,
      700,
      800
    ],
    "scale": {
      "screenTitle": {
        "size": 24,
        "weight": 800,
        "letterSpacing": "-0.02em"
      },
      "bigNumber": {
        "size": 30,
        "weight": 800,
        "letterSpacing": "-0.03em",
        "numeric": "tabular-nums"
      },
      "body": {
        "size": 15,
        "weight": 500,
        "lineHeight": 1.45
      },
      "cardTitle": {
        "size": 14,
        "weight": 700
      },
      "caption": {
        "size": 13,
        "weight": 600
      },
      "small": {
        "size": 12,
        "weight": 600,
        "note": "Мінімальний розмір тексту в застосунку"
      },
      "eyebrow": {
        "size": 12,
        "weight": 700,
        "letterSpacing": "0.05em",
        "transform": "uppercase"
      },
      "wordmark": {
        "size": 22,
        "weight": 800,
        "letterSpacing": "-0.04em",
        "note": "kusik, завжди малими літерами"
      },
      "gauge": {
        "size": 28,
        "weight": 800,
        "letterSpacing": "-0.03em",
        "numeric": "tabular-nums",
        "note": "Число в центрі кільця калорій на «Сьогодні»"
      },
      "stat": {
        "size": 17,
        "weight": 800,
        "numeric": "tabular-nums",
        "note": "Бічні показники біля кільця (з'їдено / лишилось)"
      },
      "title": {
        "size": 20,
        "weight": 800,
        "letterSpacing": "-0.02em",
        "lineHeight": 1.25,
        "note": "Заголовки sheet, діалогів і порожніх станів"
      },
      "input": {
        "size": 16,
        "lineHeight": 1.5,
        "note": "Поля вводу — 16px, щоб iOS не зумив"
      },
      "fieldNumber": {
        "size": 32,
        "weight": 800,
        "letterSpacing": "-0.02em",
        "lineHeight": 1.1,
        "numeric": "tabular-nums",
        "note": "Число, яке редагують у NumberField (my-data-edit-sheet)"
      },
      "fieldNumberSm": {
        "size": 22,
        "weight": 800,
        "lineHeight": 1.1,
        "numeric": "tabular-nums",
        "note": "Плитки цілей (goals-edit-sheet), літера аватара в профілі"
      },
      "name": {
        "size": 18,
        "weight": 800,
        "lineHeight": 1.2,
        "note": "Ім'я на картці профілю"
      },
      "achievement": {
        "size": 34,
        "weight": 800,
        "letterSpacing": "-0.03em",
        "lineHeight": 1.05,
        "numeric": "tabular-nums",
        "note": "Число на картці досягнення (рівень 3)"
      }
    }
  },
