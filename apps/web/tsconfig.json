{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"customConditions": ["source"],
		"jsx": "react-jsx",
		"types": ["vite/client", "node"],
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
