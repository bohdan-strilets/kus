  "gradient": {
    "appBackground": "linear-gradient(165deg, #FCEBD8 0%, #FBF6EE 50%, #EEF4E8 100%)",
    "logo": "linear-gradient(150deg, #FFB877 0%, #D45F22 100%)",
    "softCard": "linear-gradient(120deg, #FDEBDB, #FBF3E6)",
    "darkCard": "linear-gradient(120deg, #2A2118, #3D2D20)",
    "appIconBackground": "linear-gradient(160deg, #FFF3E6 0%, #FBF5EC 55%, #F1F2E6 100%)",
    "avatar": "linear-gradient(140deg, #FFE1C4, #F6C79B)"
  },
  "font": {
    "family": "'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "weights": [
      400,
      500,
      600,
      700,
      800
    ],
    "scale": {
      "screenTitle": {
        "size": 24,
        "weight": 800,
        "letterSpacing": "-0.02em"
      },
      "bigNumber": {
        "size": 30,
        "weight": 800,
        "letterSpacing": "-0.03em",
        "numeric": "tabular-nums"
      },
      "body": {
        "size": 15,
        "weight": 500,
        "lineHeight": 1.45
      },
      "cardTitle": {
        "size": 14,
        "weight": 700
      },
      "caption": {
        "size": 13,
        "weight": 600
      },
      "small": {
        "size": 12,
        "weight": 600,
        "note": "Мінімальний розмір тексту в застосунку"
      },
      "eyebrow": {
        "size": 12,
        "weight": 700,
        "letterSpacing": "0.05em",
        "transform": "uppercase"
      },
      "wordmark": {
        "size": 22,
        "weight": 800,
        "letterSpacing": "-0.04em",
        "note": "kusik, завжди малими літерами"
      },
      "gauge": {
        "size": 28,
        "weight": 800,
        "letterSpacing": "-0.03em",
        "numeric": "tabular-nums",
        "note": "Число в центрі кільця калорій на «Сьогодні»"
      },
      "stat": {
        "size": 17,
        "weight": 800,
        "numeric": "tabular-nums",
        "note": "Бічні показники біля кільця (з'їдено / лишилось)"
      }
    }
  },
  "radius": {
    "screen": 40,
    "sheet": 28,
    "card": 24,
    "bubble": 20,
    "bubbleTail": 6,
    "tile": 16,
    "field": 16,
    "chip": 18,
    "iconTile": 12,
    "checkbox": 6,
    "button": 24,
    "pill": 9999
  },
  "size": {
    "touchMin": 44,
    "button": 48,
    "buttonSmall": 40,
    "chip": 36,
    "navItem": 56,
    "avatarChat": 34,
    "gutter": 16
  },
  "shadow": {
    "card": "0 10px 28px rgba(80, 50, 20, 0.10)",
    "chip": "0 4px 12px rgba(80, 50, 20, 0.08)",
    "accent": "0 6px 16px rgba(185, 82, 26, 0.25)",
    "sheet": "0 -10px 30px rgba(0, 0, 0, 0.12)"
  },
  "motion": {
    "duration": {
      "fast": 120,
      "base": 200,
      "slow": 320,
      "celebrateMax": 1000
    },
    "easing": {
      "out": "cubic-bezier(.2, .8, .2, 1)",
      "spring": "cubic-bezier(.34, 1.56, .64, 1)",
      "in": "cubic-bezier(.4, 0, 1, 1)"
    }
  }
}
