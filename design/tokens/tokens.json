  "shadow": {
    "card": "0 10px 28px rgba(80, 50, 20, 0.10)",
    "chip": "0 4px 12px rgba(80, 50, 20, 0.08)",
    "accent": "0 6px 16px rgba(185, 82, 26, 0.25)",
    "sheet": "0 -10px 30px rgba(0, 0, 0, 0.12)",
    "float": "0 10px 28px rgba(80, 50, 20, 0.12)",
    "dialog": "0 20px 50px rgba(0, 0, 0, 0.2)",
    "field": "0 6px 16px rgba(80, 50, 20, 0.06)",
    "list": "0 8px 22px rgba(80, 50, 20, 0.08)",
    "achievement": "0 12px 30px rgba(185, 82, 26, 0.18)"
  },
  "motion": {
    "duration": {
      "fast": 120,
      "base": 200,
      "slow": 320,
      "celebrateMax": 1000
    },
    "easing": {
      "out": "cubic-bezier(.2, .8, .2, 1)",
      "spring": "cubic-bezier(.34, 1.56, .64, 1)",
      "in": "cubic-bezier(.4, 0, 1, 1)"
    }
  },
  "effect": {
    "blurGlow": {
      "value": "14px",
      "use": "Розмиття шару сяйва рівня 2 (ціль дня): окремий шар з filter: blur, анімується лише opacity."
    }
  }
}
