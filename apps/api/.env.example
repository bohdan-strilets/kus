# Copy to .env and fill in. Never commit .env.

# Runtime mode: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=3000

# PostgreSQL connection string. This value points to the local DB from docker-compose.yml
# (`pnpm db:up`, host port 5434). In production Railway provides DATABASE_URL.
DATABASE_URL=postgresql://kus:kus@localhost:5434/kus

# Comma-separated list of allowed web origins (never "*" in production)
CORS_ORIGIN=http://localhost:5173

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Default model id on OpenRouter (parsing food), e.g. google/gemini-3.8-flash
AI_MODEL=replace/me

# Optional per-purpose models; empty = AI_MODEL
# AI_MODEL_VISION=
# AI_MODEL_CHAT=

# Optional: timeout of one model request, ms (default 45000 — fits a full 8000-token answer; max 95000,
# the whole parse is cut at 95 s anyway to stay under the 120 s Vercel proxy limit)
# AI_TIMEOUT_MS=

# Optional: AI requests per user per local day (default 100)
# AI_DAILY_MESSAGE_LIMIT=

# Optional: photos sent to the AI per user per local day (default 30); a photo message also counts in the limit above
# AI_DAILY_PHOTO_LIMIT=

# Photo storage. STORAGE_PROVIDER: memory (dev/tests, default outside production) or s3 (any S3-compatible provider; required in production).
# STORAGE_PROVIDER=memory
# Separates environments inside one bucket (default dev)
# STORAGE_KEY_PREFIX=dev
# Required when STORAGE_PROVIDER=s3. Endpoint is a full https URL without the bucket, e.g.
# https://<account>.eu.r2.cloudflarestorage.com (Cloudflare R2, region auto) or
# https://s3.eu-central-003.backblazeb2.com (Backblaze B2, region eu-central-003)
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# Photos per message (default and hard maximum 6; can only be lowered)
# PHOTOS_PER_MESSAGE_MAX=
# Uploaded photos per user per local day (default 60, twice AI_DAILY_PHOTO_LIMIT)
# PHOTO_DAILY_UPLOAD_LIMIT=
# Hours before an upload not attached to a message is deleted (default 24)
# PHOTO_ORPHAN_TTL_HOURS=

# Signing key for access JWTs (HS256), at least 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters

# Allows POST /auth/register. v0.1 is single-user: set true to create your account, then false on prod.
ALLOW_REGISTRATION=false

# Optional cookie Domain. Leave unset: the web app calls the API through a same-origin
# /api/* rewrite on Vercel, so host-only cookies are enough (docs/architecture.md).
# COOKIE_DOMAIN=

# Shared secret the Vercel rewrite adds to every /api request (header x-kus-proxy-secret, see
# apps/web/vercel.json); requests without it get 404. Required in production, at least 32 characters,
# the same value in Railway and Vercel (paste it without spaces or a line break: Vercel sends it
# as is, so any difference gives 404 on everything). Leave unset locally.
# API_PROXY_SECRET=

# Optional, local seed only: password for the demo user demo@kus.local (min 10 chars).
# Unset = the demo user has no password and can't log in.
# SEED_DEMO_PASSWORD=
