    },
    "overInk": {
      "value": "#AB4F19",
      "use": "Текст чисел понад ціль («+180», «2 420» над стовпчиком): `over` дає лише 4,40:1 на білому — замало для дрібного тексту; over-ink ≥ 4,5:1 на surface і на bg-app. `over` лишається для дуг, крапок і стовпчиків."
    },
    "overSoft": {
      "value": "#F2A877",
      "use": "М'який відтінок перебору: декоративне тло, каталог токенів. На тижневому графіку стовпчики понад ціль малюються `over`, не over-soft."
    },
    "notice": {
      "value": "#F2894F",
      "use": "Крапка «нове» на вкладці навігації."
    },
    "scrimStrong": {
      "value": "rgb(42 33 24 / 0.45)",
      "use": "Скрим під діалогами по центру (видалення акаунта); sheet лишає `scrim` 0.4."
    }
