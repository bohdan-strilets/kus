# Copy to .env and fill in. Never commit .env.

# Runtime mode: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=3000

# PostgreSQL connection string. This value points to the local DB from docker-compose.yml
# (`pnpm db:up`, host port 5434). In production Railway provides DATABASE_URL.
DATABASE_URL=postgresql://kus:kus@localhost:5434/kus

# Comma-separated list of allowed web origins (never "*" in production)
CORS_ORIGIN=http://localhost:5173

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Model id on OpenRouter used for parsing food, e.g. google/gemini-2.5-flash
AI_MODEL=replace/me

# Signing key for access JWTs (HS256), at least 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters

# Allows POST /auth/register. v0.1 is single-user: set true to create your account, then false on prod.
ALLOW_REGISTRATION=false

# Optional cookie Domain. Leave unset: the web app calls the API through a same-origin
# /api/* rewrite on Vercel, so host-only cookies are enough (docs/architecture.md).
# COOKIE_DOMAIN=

# Optional, local seed only: password for the demo user demo@kus.local (min 10 chars).
# Unset = the demo user has no password and can't log in.
# SEED_DEMO_PASSWORD=
