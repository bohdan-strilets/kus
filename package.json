{
	"name": "kus",
	"private": true,
	"description": "Кусь — AI-трекер харчування через чат",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"postinstall": "pnpm --filter @kus/shared build && pnpm --filter @kus/api prisma:generate",
		"prepare": "husky",
		"dev": "pnpm --filter @kus/shared build && pnpm --parallel --filter @kus/shared --filter @kus/api --filter @kus/web dev",
		"build": "pnpm -r build",
		"lint": "eslint .",
		"typecheck": "pnpm --filter @kus/shared build && pnpm -r typecheck",
		"test": "pnpm -r test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db:up": "docker compose up -d",
		"db:down": "docker compose stop",
		"db:logs": "docker compose logs -f db",
		"db:reset": "docker compose down -v && docker compose up -d"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	}
}
